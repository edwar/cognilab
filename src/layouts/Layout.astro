---
import '../styles/global.css'
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0, user-scalable=yes, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>SkaLab - Automatización Inteligente con IA para tu Negocio</title>
		<meta name="description" content="Transforma tu negocio con SkaLab. Automatización de procesos empresariales usando inteligencia artificial. Aumenta la productividad, reduce costos y escala tu empresa." />
		<meta name="keywords" content="automatización, inteligencia artificial, IA, procesos empresariales, productividad, eficiencia, transformación digital, startup, tecnología" />
		<meta name="author" content="SkaLab" />
		<meta name="robots" content="index, follow" />

		<!-- Mobile Optimization -->
		<meta name="theme-color" content="#6366f1" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="SkaLab" />

		<!-- Zoom Control for Mobile -->
		<meta name="apple-touch-fullscreen" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="msapplication-tap-highlight" content="no" />
		<meta name="msapplication-TileColor" content="#6366f1" />

		<!-- Prevent zoom on input focus (iOS) -->
		<meta name="format-detection" content="telephone=no" />
		<meta name="msapplication-tap-highlight" content="no" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content="SkaLab - Automatización Inteligente con IA para tu Negocio" />
		<meta property="og:description" content="Transforma tu negocio con SkaLab. Automatización de procesos empresariales usando inteligencia artificial. Aumenta la productividad, reduce costos y escala tu empresa." />
		<meta property="og:image" content="/og-image.jpg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="SkaLab - Automatización con IA" />
		<meta property="og:site_name" content="SkaLab" />
		<meta property="og:locale" content="es_ES" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content="SkaLab - Automatización Inteligente con IA para tu Negocio" />
		<meta property="twitter:description" content="Transforma tu negocio con SkaLab. Automatización de procesos empresariales usando inteligencia artificial. Aumenta la productividad, reduce costos y escala tu empresa." />
		<meta property="twitter:image" content="/og-image.jpg" />
		<meta property="twitter:image:alt" content="SkaLab - Automatización con IA" />

		<!-- Canonical URL -->
		<link rel="canonical" href={Astro.url} />

		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Organization",
				"name": "SkaLab",
				"description": "Startup de automatización con inteligencia artificial para procesos empresariales",
				"url": "https://skalab.dev",
				"logo": "https://skalab.dev/logo.svg",
				"foundingDate": "2025",
				"sameAs": [
					"https://twitter.com/skalab",
					"https://linkedin.com/company/skalab"
				],
				"contactPoint": {
					"@type": "ContactPoint",
					"contactType": "customer service",
					"availableLanguage": "Spanish"
				},
				"areaServed": "Worldwide",
				"serviceType": "AI Automation Services"
			}
		</script>

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				"name": "SkaLab",
				"description": "Automatización inteligente con IA para tu negocio",
				"url": "https://skalab.dev",
				"potentialAction": {
					"@type": "SearchAction",
					"target": "https://skalab.dev/search?q={search_term_string}",
					"query-input": "required name=search_term_string"
				}
			}
		</script>

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Service",
				"name": "Automatización con Inteligencia Artificial",
				"description": "Servicios de automatización de procesos empresariales usando IA",
				"provider": {
					"@type": "Organization",
					"name": "SkaLab"
				},
				"serviceType": "AI Automation",
				"areaServed": "Worldwide",
				"hasOfferCatalog": {
					"@type": "OfferCatalog",
					"name": "Servicios de Automatización",
					"itemListElement": [
						{
							"@type": "Offer",
							"itemOffered": {
								"@type": "Service",
								"name": "Análisis y Descubrimiento",
								"description": "Evaluación de procesos actuales para identificar oportunidades de automatización"
							}
						},
						{
							"@type": "Offer",
							"itemOffered": {
								"@type": "Service",
								"name": "Diseño y Desarrollo",
								"description": "Desarrollo de soluciones de IA personalizadas"
							}
						},
						{
							"@type": "Offer",
							"itemOffered": {
								"@type": "Service",
								"name": "Implementación y Despliegue",
								"description": "Integración de soluciones en sistemas existentes"
							}
						}
					]
				}
			}
		</script>

		<!-- AOS CSS -->
		<link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
	</head>
	<body class="bg-background">
		<script>
      import AOS from 'aos';
      AOS.init({
        once: true, // Animaciones solo una vez
        duration: 800, // Duración de la animación en ms
      });

      // Mobile zoom and orientation control
      (function() {
        'use strict';

        // Prevent zoom on double tap
        let lastTouchEnd = 0;
        document.addEventListener('touchend', function(event) {
          const now = (new Date()).getTime();
          if (now - lastTouchEnd <= 300) {
            event.preventDefault();
          }
          lastTouchEnd = now;
        }, false);

        // Handle orientation change
        window.addEventListener('orientationchange', function() {
          // Small delay to allow orientation to settle
          setTimeout(function() {
            window.dispatchEvent(new Event('resize'));
          }, 100);
        });

        // Prevent iOS zoom on input focus
        const inputs = document.querySelectorAll('input, textarea, select');
        inputs.forEach(function(input) {
          input.addEventListener('focus', function() {
            // Prevent zoom by temporarily disabling viewport scaling
            const viewport = document.querySelector('meta[name=viewport]') as HTMLMetaElement | null;
            if (viewport) {
              viewport.setAttribute('content', 'width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, viewport-fit=cover');
            }
          });

          input.addEventListener('blur', function() {
            // Restore normal viewport scaling
            const viewport = document.querySelector('meta[name=viewport]') as HTMLMetaElement | null;
            if (viewport) {
              viewport.setAttribute('content', 'width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0, user-scalable=yes, viewport-fit=cover');
            }
          });
        });

        // Handle viewport height on mobile browsers
        function setVH() {
          const vh = window.innerHeight * 0.01;
          document.documentElement.style.setProperty('--vh', `${vh}px`);
        }

        setVH();
        window.addEventListener('resize', setVH);
        window.addEventListener('orientationchange', setVH);
      })();
    </script>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

  /* Smooth scroll behavior for the entire page */
  html {
    scroll-behavior: smooth;
  }

  /* Mobile Zoom Control */
  @media screen and (max-width: 768px) {
    /* Prevent zoom on input focus in iOS */
    input[type="text"],
    input[type="email"],
    input[type="tel"],
    input[type="password"],
    textarea,
    select {
      font-size: 16px !important;
    }

    /* Prevent zoom on buttons and interactive elements */
    button,
    .button,
    [role="button"],
    a[role="button"] {
      min-height: 44px;
      min-width: 44px;
      touch-action: manipulation;
    }

    /* Ensure text remains readable */
    body {
      font-size: 16px;
      line-height: 1.6;
    }

    /* Prevent horizontal scroll */
    body {
      overflow-x: hidden;
      width: 100%;
    }

    /* Optimize for touch interactions */
    * {
      -webkit-tap-highlight-color: transparent;
      tap-highlight-color: transparent;
    }
  }

  /* High DPI displays */
  @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    /* Ensure sharp graphics on retina displays */
    .logo,
    .icon {
      image-rendering: -webkit-optimize-contrast;
      image-rendering: crisp-edges;
    }
  }

  /* Landscape orientation on mobile */
  @media screen and (max-height: 500px) and (orientation: landscape) {
    /* Adjust for landscape mode */
    .hero-section {
      min-height: 100vh;
      padding-top: 80px; /* Account for fixed navbar */
    }
  }

  /* Prevent text selection issues on mobile */
  .no-select {
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
  }

  /* Improve scrolling performance */
  * {
    -webkit-overflow-scrolling: touch;
  }

  /* Safe area handling for devices with notches */
  .safe-area-top {
    padding-top: env(safe-area-inset-top);
  }

  .safe-area-bottom {
    padding-bottom: env(safe-area-inset-bottom);
  }

  .safe-area-left {
    padding-left: env(safe-area-inset-left);
  }

  .safe-area-right {
    padding-right: env(safe-area-inset-right);
  }
</style>
