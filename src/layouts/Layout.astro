---
import "../styles/global.css";
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0, user-scalable=yes, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..800;1,9..40,300..800&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <title>CogniLab — Software como Servicio para tu Negocio</title>
    <meta name="description" content="Creamos productos SaaS que resuelven problemas reales: agendamiento inteligente (VLink), gestión empresarial (Loki), POS y facturación DIAN (Hermes), y sorteos gamificados (Thor)." />
    <meta name="keywords" content="SaaS, software como servicio, agendamiento online, gestión empresarial, POS Colombia, facturación electrónica DIAN, sorteos gamificados" />
    <meta name="author" content="CogniLab" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a0e1a" />
    <meta name="msapplication-TileColor" content="#0a0e1a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CogniLab" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content="CogniLab — Software como Servicio para tu Negocio" />
    <meta property="og:description" content="Creamos productos SaaS que resuelven problemas reales." />
    <meta property="og:image" content="/og-image.jpg" />
    <meta property="og:site_name" content="CogniLab" />
    <meta property="og:locale" content="es_ES" />

    <link rel="canonical" href={Astro.url} />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "CogniLab",
        "description": "Estudio de productos SaaS",
        "url": "https://cognilab.dev",
        "foundingDate": "2025",
        "areaServed": "Worldwide",
        "serviceType": "SaaS Products"
      }
    </script>
  </head>
  <body class="bg-background text-foreground antialiased leading-relaxed overflow-x-hidden">
    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      // Respect prefers-reduced-motion
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!prefersReducedMotion) {
        // Global GSAP defaults
        gsap.defaults({ ease: "power3.out", duration: 0.8 });

        // Scroll-triggered reveals for [data-gsap="reveal"]
        gsap.utils.toArray<HTMLElement>("[data-gsap='reveal']").forEach((el) => {
          gsap.from(el, {
            scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none none" },
            y: 50, opacity: 0, duration: 0.9,
          });
        });

        // Stagger groups [data-gsap="stagger"]
        gsap.utils.toArray<HTMLElement>("[data-gsap='stagger']").forEach((group) => {
          const children = group.children;
          gsap.from(children, {
            scrollTrigger: { trigger: group, start: "top 80%", toggleActions: "play none none none" },
            y: 40, opacity: 0, duration: 0.7, stagger: 0.1,
          });
        });

        // Parallax elements [data-gsap="parallax"]
        gsap.utils.toArray<HTMLElement>("[data-gsap='parallax']").forEach((el) => {
          const speed = parseFloat(el.dataset.speed || "0.3");
          gsap.to(el, {
            scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: 1 },
            y: () => -100 * speed,
          });
        });

        // Scale-in [data-gsap="scale"]
        gsap.utils.toArray<HTMLElement>("[data-gsap='scale']").forEach((el) => {
          gsap.from(el, {
            scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none none" },
            scale: 0.9, opacity: 0, duration: 0.8,
          });
        });

        // Slide from left [data-gsap="slide-left"]
        gsap.utils.toArray<HTMLElement>("[data-gsap='slide-left']").forEach((el) => {
          gsap.from(el, {
            scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none none" },
            x: -60, opacity: 0, duration: 0.9,
          });
        });

        // Slide from right [data-gsap="slide-right"]
        gsap.utils.toArray<HTMLElement>("[data-gsap='slide-right']").forEach((el) => {
          gsap.from(el, {
            scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none none" },
            x: 60, opacity: 0, duration: 0.9,
          });
        });

        // Counter animation [data-gsap="counter"]
        gsap.utils.toArray<HTMLElement>("[data-gsap='counter']").forEach((el) => {
          const target = parseInt(el.dataset.target || "0", 10);
          const obj = { val: 0 };
          gsap.to(obj, {
            scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none none" },
            val: target, duration: 2, ease: "power2.out",
            onUpdate: () => { el.textContent = Math.round(obj.val).toString(); },
          });
        });
      }

      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener("click", (e) => {
          e.preventDefault();
          const target = document.querySelector(anchor.getAttribute("href") || "");
          if (target) target.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });
    </script>
    <slot />
  </body>
</html>

<style>
  html, body { margin: 0; width: 100%; height: 100%; }
  html { scroll-behavior: smooth; }

  @media screen and (max-width: 768px) {
    body { font-size: 16px; line-height: 1.7; }
    h1 { font-size: 2rem; line-height: 1.15; letter-spacing: -0.03em; }
    h2 { font-size: 1.625rem; line-height: 1.2; letter-spacing: -0.025em; }
    h3 { font-size: 1.25rem; line-height: 1.3; }
  }

  @media screen and (min-width: 769px) and (max-width: 1024px) {
    body { font-size: 17px; }
    h1 { font-size: 2.5rem; line-height: 1.1; }
    h2 { font-size: 2rem; line-height: 1.15; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
