---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0, user-scalable=yes, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>CogniLab — Software como Servicio para tu Negocio</title>
    <meta
      name="description"
      content="Creamos productos SaaS que resuelven problemas reales: agendamiento inteligente (VLink), gestión empresarial (Loki), POS y facturación DIAN (Hermes), y sorteos gamificados (Thor)."
    />
    <meta
      name="keywords"
      content="SaaS, software como servicio, agendamiento online, gestión empresarial, POS Colombia, facturación electrónica DIAN, sorteos gamificados, productos digitales, startups"
    />
    <meta name="author" content="CogniLab" />
    <meta name="robots" content="index, follow" />

    <!-- Mobile Optimization -->
    <meta name="theme-color" content="#6366f1" />
    <meta name="msapplication-TileColor" content="#6366f1" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="CogniLab" />

    <!-- Zoom Control for Mobile -->
    <meta name="apple-touch-fullscreen" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="msapplication-tap-highlight" content="no" />
    <meta name="msapplication-TileColor" content="#6366f1" />

    <!-- Prevent zoom on input focus (iOS) -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="msapplication-tap-highlight" content="no" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta
      property="og:title"
      content="CogniLab — Software como Servicio para tu Negocio"
    />
    <meta
      property="og:description"
      content="Creamos productos SaaS que resuelven problemas reales: agendamiento inteligente, gestión empresarial, POS con facturación DIAN y sorteos gamificados."
    />
    <meta property="og:image" content="/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CogniLab — Productos SaaS" />
    <meta property="og:site_name" content="CogniLab" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta
      property="twitter:title"
      content="CogniLab — Software como Servicio para tu Negocio"
    />
    <meta
      property="twitter:description"
      content="Creamos productos SaaS que resuelven problemas reales: agendamiento inteligente, gestión empresarial, POS con facturación DIAN y sorteos gamificados."
    />
    <meta property="twitter:image" content="/og-image.jpg" />
    <meta
      property="twitter:image:alt"
      content="CogniLab — Productos SaaS"
    />

    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "CogniLab",
        "description": "Estudio de productos SaaS: agendamiento, gestión empresarial, POS y sorteos gamificados",
        "url": "https://cognilab.dev",
        "logo": "https://cognilab.dev/logo.svg",
        "foundingDate": "2025",
        "sameAs": [
          "https://twitter.com/cognilab",
          "https://linkedin.com/company/cognilab"
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer service",
          "availableLanguage": "Spanish"
        },
        "areaServed": "Worldwide",
        "serviceType": "SaaS Products"
      }
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "CogniLab",
        "description": "Productos SaaS para optimizar tu negocio: agendamiento, gestión, POS y sorteos",
        "url": "https://cognilab.dev",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://cognilab.dev/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "Productos SaaS",
        "description": "Plataformas SaaS: agendamiento profesional, gestión empresarial, POS con facturación DIAN y sorteos gamificados",
        "provider": {
          "@type": "Organization",
          "name": "CogniLab"
        },
        "serviceType": "SaaS Products",
        "areaServed": "Worldwide",
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Productos CogniLab",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "VLink",
                "description": "Plataforma de agendamiento profesional con Google Calendar, catálogo de servicios y dashboards"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Loki",
                "description": "Sistema de gestión empresarial: ventas, inventario, gastos y fidelización de clientes"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Hermes",
                "description": "Sistema POS con facturación electrónica DIAN, inventario y soporte offline para Colombia"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Thor",
                "description": "Plataforma de sorteos gamificados con ruleta en vivo y aleatoriedad verificable"
              }
            }
          ]
        }
      }
    </script>

    <!-- Preload fonts for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-background text-foreground antialiased leading-relaxed">
    <script>
      import AOS from "aos";
      AOS.init({
        once: true,
        duration: 600,
        startEvent: "DOMContentLoaded",
        disable: window.matchMedia("(prefers-reduced-motion: reduce)").matches,
      });

      // Mobile zoom and orientation control
      (function () {
        "use strict";

        // Prevent zoom on double tap
        let lastTouchEnd = 0;
        document.addEventListener(
          "touchend",
          function (event) {
            const now = new Date().getTime();
            if (now - lastTouchEnd <= 300) {
              event.preventDefault();
            }
            lastTouchEnd = now;
          },
          false,
        );

        // Handle orientation change
        window.addEventListener("orientationchange", function () {
          // Small delay to allow orientation to settle
          setTimeout(function () {
            window.dispatchEvent(new Event("resize"));
          }, 100);
        });

        // Prevent iOS zoom on input focus
        const inputs = document.querySelectorAll("input, textarea, select");
        inputs.forEach(function (input) {
          input.addEventListener("focus", function () {
            // Prevent zoom by temporarily disabling viewport scaling
            const viewport = document.querySelector(
              "meta[name=viewport]",
            ) as HTMLMetaElement | null;
            if (viewport) {
              viewport.setAttribute(
                "content",
                "width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, viewport-fit=cover",
              );
            }
          });

          input.addEventListener("blur", function () {
            // Restore normal viewport scaling
            const viewport = document.querySelector(
              "meta[name=viewport]",
            ) as HTMLMetaElement | null;
            if (viewport) {
              viewport.setAttribute(
                "content",
                "width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0, user-scalable=yes, viewport-fit=cover",
              );
            }
          });
        });

        // Handle viewport height on mobile browsers
        function setVH() {
          const vh = window.innerHeight * 0.01;
          document.documentElement.style.setProperty("--vh", `${vh}px`);
        }

        setVH();
        window.addEventListener("resize", setVH);
        window.addEventListener("orientationchange", setVH);
      })();
    </script>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  /* Smooth scroll behavior for the entire page */
  html {
    scroll-behavior: smooth;
  }

  /* Enhanced Mobile Typography for Better Readability */
  @media screen and (max-width: 768px) {
    /* Base typography improvements */
    body {
      font-size: 16px;
      line-height: 1.7;
      letter-spacing: 0.01em;
      font-weight: 400;
    }

    /* Headings optimization for mobile */
    h1 {
      font-size: 1.75rem;
      line-height: 1.2;
      letter-spacing: -0.025em;
      margin-bottom: 1rem;
    }

    h2 {
      font-size: 1.5rem;
      line-height: 1.25;
      letter-spacing: -0.02em;
      margin-bottom: 0.875rem;
    }

    h3 {
      font-size: 1.25rem;
      line-height: 1.3;
      letter-spacing: -0.015em;
      margin-bottom: 0.75rem;
    }

    h4 {
      font-size: 1.125rem;
      line-height: 1.35;
      margin-bottom: 0.625rem;
    }

    h5,
    h6 {
      font-size: 1rem;
      line-height: 1.4;
      margin-bottom: 0.5rem;
    }

    /* Paragraph and text improvements */
    p {
      line-height: 1.7;
      margin-bottom: 1rem;
      letter-spacing: 0.005em;
    }

    /* List improvements */
    ul,
    ol {
      line-height: 1.6;
      margin-bottom: 1rem;
    }

    li {
      margin-bottom: 0.5rem;
      line-height: 1.6;
    }

    /* Better text rendering */
    body,
    p,
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Improved contrast for better readability */
    .text-muted-foreground {
      opacity: 0.85;
    }

    /* Better spacing for readability */
    .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    /* Optimize button text for mobile */
    button {
      font-size: 16px;
      line-height: 1.4;
      letter-spacing: 0.01em;
    }
  }

  /* Tablet optimizations */
  @media screen and (min-width: 769px) and (max-width: 1024px) {
    body {
      font-size: 17px;
      line-height: 1.65;
    }

    h1 {
      font-size: 2.25rem;
      line-height: 1.15;
    }

    h2 {
      font-size: 1.875rem;
      line-height: 1.2;
    }
  }

  /* High DPI displays */
  @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
    /* Ensure sharp graphics on retina displays */
    .logo,
    .icon {
      image-rendering: -webkit-optimize-contrast;
      image-rendering: crisp-edges;
    }
  }

  /* Landscape orientation on mobile */
  @media screen and (max-height: 500px) and (orientation: landscape) {
    /* Adjust for landscape mode */
    .hero-section {
      min-height: 100vh;
      padding-top: 80px; /* Account for fixed navbar */
    }
  }

  /* Prevent text selection issues on mobile */
  .no-select {
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
  }

  /* Improve scrolling performance */
  * {
    -webkit-overflow-scrolling: touch;
  }

  /* Safe area handling for devices with notches */
  .safe-area-top {
    padding-top: env(safe-area-inset-top);
  }

  .safe-area-bottom {
    padding-bottom: env(safe-area-inset-bottom);
  }

  .safe-area-left {
    padding-left: env(safe-area-inset-left);
  }

  .safe-area-right {
    padding-right: env(safe-area-inset-right);
  }
</style>
