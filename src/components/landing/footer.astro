---
// src/components/Footer.astro
import { Icon } from "astro-icon/components";
---

<footer class="bg-background border-t border-border/40 py-12 sm:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="flex flex-col sm:flex-row justify-between items-center pb-8 border-b border-border/40"
    >
      <a href="/" class="flex items-center gap-2">
        <div
          class="relative flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 border border-primary/20"
        >
          <span class="text-primary font-bold text-xl">S</span>
        </div>
        <div class="flex flex-col">
          <span
            class="font-bold text-xl tracking-tight text-foreground leading-none"
            >SkaLab</span
          >
          <span
            class="text-[0.6rem] uppercase tracking-widest text-muted-foreground font-semibold leading-none"
            >AI Agency</span
          >
        </div>
      </a>

      <div class="flex space-x-4 mt-6 sm:mt-0">
        <a
          href="#"
          aria-label="Github"
          class="text-muted-foreground hover:text-primary transition-colors duration-300"
        >
          <Icon name="lucide:github" class="h-6 w-6" />
        </a>
        <a
          href="#"
          aria-label="Twitter"
          class="text-muted-foreground hover:text-primary transition-colors duration-300"
        >
          <Icon name="lucide:twitter" class="h-6 w-6" />
        </a>
        <a
          href="#"
          aria-label="LinkedIn"
          class="text-muted-foreground hover:text-primary transition-colors duration-300"
        >
          <Icon name="lucide:linkedin" class="h-6 w-6" />
        </a>
        <a
          href="mailto:hola@skalab.dev"
          aria-label="Email"
          class="text-muted-foreground hover:text-primary transition-colors duration-300"
        >
          <Icon name="lucide:mail" class="h-6 w-6" />
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 mt-12 text-sm">
      <div>
        <h3 class="font-semibold text-foreground uppercase tracking-wider mb-4">
          Servicios
        </h3>
        <ul role="list" class="space-y-2">
          <li>
            <a
              href="#services"
              class="text-muted-foreground hover:text-primary transition-colors duration-300"
              >Desarrollo de IA</a>
          </li>
          <li>
            <a
              href="#services"
              class="text-muted-foreground hover:text-primary transition-colors duration-300"
              >Automatización</a>
          </li>
          <li>
            <a
              href="#services"
              class="text-muted-foreground hover:text-primary transition-colors duration-300"
              >Software a Medida</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-foreground uppercase tracking-wider mb-4">
          Compañía
        </h3>
        <ul role="list" class="space-y-2">
          <li>
            <a
              href="#about"
              class="text-muted-foreground hover:text-primary transition-colors duration-300"
              >Nosotros</a>
          </li>
          <li>
            <a
              href="#contact"
              class="text-muted-foreground hover:text-primary transition-colors duration-300"
              >Contacto</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-foreground uppercase tracking-wider mb-4">
          Legal
        </h3>
        <ul role="list" class="space-y-2">
          <li>
            <a
              href="#"
              class="text-muted-foreground hover:text-primary transition-colors duration-300"
              >Privacidad</a>
          </li>
          <li>
            <a
              href="#"
              class="text-muted-foreground hover:text-primary transition-colors duration-300"
              >Términos</a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 pt-8 border-t border-border/40 text-center text-sm text-muted-foreground"
    >
      <p>
        &copy; {new Date().getFullYear()} SkaLab. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
