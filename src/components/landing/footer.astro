---
// src/components/Footer.astro
import { Icon } from 'astro-icon/components';
---

<footer class="bg-gray-900 dark:bg-gray-950 text-gray-400 py-12 sm:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col sm:flex-row justify-between items-center pb-8 border-b border-gray-700 dark:border-gray-800">
      
      <a href="/" class="flex items-center space-x-2">
        <span class="text-2xl font-bold text-white">SkaLab</span>
      </a>

      <div class="flex space-x-4 mt-6 sm:mt-0">
        <a href="#" aria-label="Github" class="text-gray-400 hover:text-white transition-colors duration-300">
          <Icon name="lucide:github" class="h-6 w-6" />
        </a>
        <a href="#" aria-label="Twitter" class="text-gray-400 hover:text-white transition-colors duration-300">
          <Icon name="lucide:twitter" class="h-6 w-6" />
        </a>
        <a href="#" aria-label="LinkedIn" class="text-gray-400 hover:text-white transition-colors duration-300">
          <Icon name="lucide:linkedin" class="h-6 w-6" />
        </a>
        <a href="#" aria-label="Email" class="text-gray-400 hover:text-white transition-colors duration-300">
          <Icon name="lucide:mail" class="h-6 w-6" />
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-8 mt-12 text-sm">
      
      <div>
        <h3 class="font-semibold text-white uppercase tracking-wider">Producto</h3>
        <ul role="list" class="mt-4 space-y-2">
          <li><a href="#features" class="hover:text-white transition-colors duration-300">Funcionalidades</a></li>
          <li><a href="#how-it-works" class="hover:text-white transition-colors duration-300">Cómo funciona</a></li>
          <li><a href="#pricing" class="hover:text-white transition-colors duration-300">Precios</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-white uppercase tracking-wider">Compañía</h3>
        <ul role="list" class="mt-4 space-y-2">
          <li><a href="#home" class="hover:text-white transition-colors duration-300">Acerca de nosotros</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-white uppercase tracking-wider">Recursos</h3>
        <ul role="list" class="mt-4 space-y-2">
          <li><a href="#faqs" class="hover:text-white transition-colors duration-300">FAQ</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-700 dark:border-gray-800 text-center text-sm text-gray-500">
      <p>&copy; {new Date().getFullYear()} SkaLab. Todos los derechos reservados.</p>
    </div>

  </div>
</footer>