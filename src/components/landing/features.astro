---
import { Icon } from "astro-icon/components";
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
} from "@/components/ui/card";

const services = [
  {
    icon: "lucide:calendar-check",
    title: "Agendamiento Inteligente",
    description:
      "VLink automatiza la reserva de citas con sincronización bidireccional de Google Calendar, catálogo de servicios y dashboards en tiempo real.",
    color: "primary",
  },
  {
    icon: "lucide:building-2",
    title: "Gestión Empresarial",
    description:
      "Loki centraliza ventas, inventario, gastos y clientes en un solo lugar. Ideal para emprendedores que quieren control total.",
    color: "secondary",
  },
  {
    icon: "lucide:shopping-cart",
    title: "POS y Facturación DIAN",
    description:
      "Hermes es un sistema POS moderno con facturación electrónica ante la DIAN, soporte offline y gestión de inventario.",
    color: "accent",
  },
  {
    icon: "lucide:party-popper",
    title: "Sorteos Gamificados",
    description:
      "Thor permite vender bonos y sortear productos digitales con ruleta en vivo, aleatoriedad SHA-256 verificable.",
    color: "primary",
  },
  {
    icon: "lucide:smartphone",
    title: "Mobile First",
    description:
      "Todos nuestros productos están optimizados para dispositivos móviles con interfaces rápidas y diseño responsive.",
    color: "secondary",
  },
  {
    icon: "lucide:cloud",
    title: "Infraestructura Cloud",
    description:
      "Plataformas construidas sobre Next.js, Neon y TypeScript. Escalables, seguras y con soporte técnico continuo.",
    color: "accent",
  },
];

const colorMap: Record<string, string> = {
  primary: "from-primary/20 to-primary/5 border-primary/20 hover:border-primary/40",
  secondary: "from-secondary/20 to-secondary/5 border-secondary/20 hover:border-secondary/40",
  accent: "from-accent/20 to-accent/5 border-accent/20 hover:border-accent/40",
};

const iconBg: Record<string, string> = {
  primary: "bg-primary/10 text-primary group-hover:bg-primary/20",
  secondary: "bg-secondary/10 text-secondary group-hover:bg-secondary/20",
  accent: "bg-accent/10 text-accent group-hover:bg-accent/20",
};
---

<section id="services" class="py-20 md:py-32 px-4 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-background via-muted/10 to-background"></div>
  <div class="absolute top-1/2 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-[120px]" aria-hidden="true"></div>

  <div class="container mx-auto px-4 max-w-7xl relative z-10">
    <div class="text-center mb-16" data-gsap="reveal">
      <div class="inline-flex items-center rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-xs font-mono font-medium text-primary tracking-wider uppercase mb-6">
        <Icon name="lucide:sparkles" class="w-3.5 h-3.5 mr-2" />
        Nuestros Productos
      </div>
      <h2 class="font-display text-3xl md:text-5xl lg:text-6xl font-extrabold text-foreground leading-tight mb-6">
        Un Ecosistema de <span class="gradient-text">Productos SaaS</span>
      </h2>
      <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto">
        Cuatro plataformas diseñadas para resolver problemas específicos de empresas modernas.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-gsap="stagger">
      {
        services.map((service) => (
          <div class={`group relative bg-gradient-to-br ${colorMap[service.color]} border rounded-2xl p-6 transition-all duration-500 hover:shadow-lg hover:-translate-y-1 hover-glow cursor-default`}>
            <div class="mb-4 p-3 rounded-xl inline-flex transition-all duration-300">
              <div class={`p-3 rounded-xl ${iconBg[service.color]} transition-all duration-300`}>
                <Icon name={service.icon} class="w-6 h-6" />
              </div>
            </div>
            <h3 class="font-display text-lg font-bold text-foreground mb-2">
              {service.title}
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {service.description}
            </p>
            {/* Hover shine effect */}
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-transparent via-white/[0.03] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none" />
          </div>
        ))
      }
    </div>

    <div class="mt-16 text-center" data-gsap="reveal">
      <a
        href="#projects"
        class="group inline-flex items-center gap-2 px-8 py-4 text-base font-semibold rounded-2xl bg-primary text-primary-foreground transition-all duration-300 hover:shadow-[0_0_30px_oklch(0.78_0.15_195/0.3)] hover:-translate-y-0.5"
      >
        Ver todos los Productos
        <Icon name="lucide:arrow-right" class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>

<style>
  .hover-glow::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, oklch(0.78 0.15 195 / 0.4), oklch(0.72 0.12 290 / 0.4));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .hover-glow:hover::before { opacity: 1; }
</style>
