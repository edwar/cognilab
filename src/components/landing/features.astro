---
// Services.astro
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
} from "@/components/ui/card";
import { Icon } from "astro-icon/components";

const services = [
  {
    icon: "lucide:calendar-check",
    title: "Agendamiento Inteligente",
    description:
      "VLink automatiza la reserva de citas con sincronización bidireccional de Google Calendar, catálogo de servicios y dashboards en tiempo real.",
  },
  {
    icon: "lucide:building-2",
    title: "Gestión Empresarial",
    description:
      "Loki centraliza ventas, inventario, gastos y clientes en un solo lugar. Ideal para emprendedores que quieren control total de su negocio.",
  },
  {
    icon: "lucide:shopping-cart",
    title: "POS y Facturación DIAN",
    description:
      "Hermes es un sistema POS moderno con facturación electrónica ante la DIAN, soporte offline y gestión de inventario para negocios colombianos.",
  },
  {
    icon: "lucide:party-popper",
    title: "Sorteos Gamificados",
    description:
      "Thor permite vender bonos y sortear productos digitales con ruleta en vivo, aleatoriedad SHA-256 verificable y pagos Wompi/Bold.",
  },
  {
    icon: "lucide:smartphone",
    title: "Experiencia Mobile First",
    description:
      "Todos nuestros productos están optimizados para dispositivos móviles, con interfaces rápidas y diseño responsive que funciona en cualquier pantalla.",
  },
  {
    icon: "lucide:cloud",
    title: "Infraestructura Cloud",
    description:
      "Plataformas construidas sobre Next.js, Neon y TypeScript. Escalables, seguras y con soporte técnico continuo para garantizar tu operación.",
  },
];
---

<section id="services" class="py-20 md:py-32 px-4 relative overflow-hidden">
  <!-- Background Elements -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-background via-muted/10 to-background"
  >
  </div>
  <div
    class="absolute top-1/2 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-secondary/5 rounded-full blur-3xl"
  >
  </div>

  <div class="container mx-auto px-4 max-w-7xl relative z-10">
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-4 backdrop-blur-sm"
      >
        <Icon name="lucide:sparkles" class="w-4 h-4 mr-2" />
        Nuestros Productos
      </div>
      <h2
        class="text-3xl md:text-5xl lg:text-6xl font-bold text-foreground leading-tight mb-6"
      >
        Un Ecosistema de <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary"
          >Productos SaaS</span
        >
      </h2>
      <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto">
        Cuatro plataformas diseñadas para resolver problemas específicos de
        empresas modernas. Cada una construida con tecnología sólida y
        experiencia de usuario impecable.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        services.map((service, index) => (
          <Card className="group relative bg-card/50 backdrop-blur-sm border border-border/50 hover:border-primary/50 rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-primary/10 hover:-translate-y-1">
            <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            <CardHeader className="relative z-10">
              <div class="mb-4 p-3 bg-primary/10 rounded-lg inline-flex w-fit group-hover:bg-primary/20 transition-colors duration-300">
                <Icon name={service.icon} class="w-8 h-8 text-primary" />
              </div>
              <CardTitle className="text-xl font-bold text-foreground mb-2">
                {service.title}
              </CardTitle>
              <CardDescription className="text-muted-foreground leading-relaxed">
                {service.description}
              </CardDescription>
            </CardHeader>
          </Card>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="mt-16 text-center">
      <a
        href="#projects"
        class="inline-flex items-center justify-center px-8 py-4 text-base font-medium rounded-lg text-primary-foreground bg-primary hover:bg-primary/90 transition-all duration-200 shadow-glow hover:shadow-lg hover:-translate-y-1"
      >
        Ver todos los Productos
        <Icon name="lucide:arrow-right" class="w-5 h-5 ml-2" />
      </a>
    </div>
  </div>
</section>
