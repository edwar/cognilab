---
import { Accordion} from "@/components/accordion/Accordion";

// Faqs.astro

// Define la constante con los datos de las preguntas frecuentes
const faqs = [
  {
    title: "¿Qué productos tiene CogniLab actualmente?",
    description: "Actualmente tenemos cuatro productos activos: VLink (agendamiento profesional con Google Calendar), Loki (gestión empresarial: ventas, inventario y finanzas), Hermes (sistema POS con facturación electrónica DIAN para Colombia) y Thor (plataforma de sorteos gamificados con ruleta en vivo)."
  },
  {
    title: "¿Los productos son gratuitos o tienen costo?",
    description: "Cada producto tiene su propio modelo de negocio. Por ejemplo, Hermes es gratuito en su core (POS, inventario, reportes) y cobra solo por facturación electrónica. Thor cobra solo el 1% del recaudo por sorteo. Visita cada producto para ver sus precios específicos."
  },
  {
    title: "¿Necesito conocimientos técnicos para usar los productos?",
    description: "¡Para nada! Todos nuestros productos están diseñados con interfaces intuitivas y experiencia de usuario cuidada. Si sabes usar un navegador web, puedes usar cualquiera de nuestras plataformas sin capacitación técnica."
  },
  {
    title: "¿Puedo solicitar una funcionalidad o producto nuevo?",
    description: "Sí, nos encanta escuchar a los usuarios. Cada producto tiene un canal de soporte y retroalimentación. Además, si tienes una idea para un nuevo producto SaaS, contáctanos y evaluamos si encaja en nuestra visión."
  }
];
---

<section id="faqs" class="py-16 sm:py-24 bg-muted/20">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-center text-foreground">
      Preguntas Frecuentes
    </h2>
    <p class="mt-4 text-lg text-center text-muted-foreground">
      Todo lo que necesitas saber sobre nuestros productos SaaS.
    </p>

    <div class="mt-12">
      <Accordion data={faqs} client:idle />
    </div>
  </div>
</section>