---
// src/components/HowItWorksSection.astro
import { Icon } from "astro-icon/components";
import { Card, CardDescription, CardHeader, CardTitle } from "../ui/card";

const steps = [
  {
    number: "01",
    icon: "lucide:search-check",
    title: "Identificamos el Problema",
    description:
      "Analizamos las necesidades reales del mercado y definimos el producto mínimo viable que las resuelve de forma efectiva.",
  },
  {
    number: "02",
    icon: "lucide:code",
    title: "Construimos el Producto",
    description:
      "Desarrollamos con Next.js, TypeScript y Neon. Arquitectura moderna, escalable y con experiencia de usuario impecable.",
  },
  {
    number: "03",
    icon: "lucide:rocket",
    title: "Lanzamos y Probamos",
    description:
      "Publicamos el producto, recogemos feedback real de usuarios y ajustamos rápido. Iteramos hasta que encaje perfectamente.",
  },
  {
    number: "04",
    icon: "lucide:refresh-cw",
    title: "Evolución Continua",
    description:
      "Cada producto recibe mejoras constantes: nuevas funcionalidades, optimizaciones de rendimiento y soporte técnico continuo.",
  },
];
---

<section id="how-it-works" class="py-16 md:py-24 bg-muted/20">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="text-center mb-12 md:mb-16">
      <h2
        class="text-3xl md:text-5xl font-bold text-foreground leading-tight mb-4"
      >
        Cómo Creamos Productos SaaS
      </h2>
      <p class="text-lg text-muted-foreground">
        De la idea al producto funcionando — nuestro proceso en cuatro etapas.
      </p>
    </div>

    <div class="relative px-8">
      <div
        class="absolute inset-y-0 left-1/2 w-0.5 -ml-0.5 bg-border hidden lg:block"
      >
      </div>

      {
        steps.map((step, index) => (
          <div
            class={`relative mb-8 flex ${index % 2 === 0 ? "lg:flex-row" : "lg:flex-row-reverse"} items-center justify-center w-full`}
          >
            <div
              class={`w-full md:w-3/4 lg:w-1/2 ${index % 2 === 0 ? "lg:pr-20" : "lg:pl-8"} text-center lg:text-left`}
            >
              <div data-aos={index % 2 === 0 ? "fade-right" : "fade-left"}>
                <div class="flex items-center justify-center lg:justify-start gap-4 mb-4 lg:mb-0">
                  <h4 class="text-3xl font-bold text-primary/70">
                    {step.number}
                  </h4>

                  <div class="lg:hidden flex items-center justify-center p-2 rounded-full bg-primary text-primary-foreground shadow-md">
                    <Icon name={step.icon} class="w-8 h-8" />
                  </div>
                </div>
                <Card className="relative border rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-primary/10 hover:-translate-y-1">
                  <CardHeader>
                    <CardTitle className="text-2xl md:text-4xl font-extrabold text-primary">
                      {step.title}
                    </CardTitle>
                  </CardHeader>
                  <CardDescription className="px-6 pb-6 text-sm md:text-base text-muted-foreground">
                    {step.description}
                  </CardDescription>
                </Card>
              </div>
            </div>

            <div
              class={`hidden lg:flex items-center justify-center p-2 rounded-full bg-primary text-primary-foreground z-20 shadow-md -translate-y-1/2 top-1/2 left-1/2 ${index % 2 === 0 ? "-ml-14" : "ml-14"}`}
            >
              <Icon name={step.icon} class="w-8 h-8" />
            </div>

            <div class="hidden lg:block w-1/2" />
          </div>
        ))
      }
    </div>
  </div>
</section>
