---
// src/components/HowItWorksSection.astro
import { Icon } from "astro-icon/components";
import { Card, CardDescription, CardHeader, CardTitle } from "../ui/card";

const steps = [
  {
    number: "01",
    icon: "lucide:search-check",
    title: "Análisis y Descubrimiento",
    description:
      "Evaluamos tus procesos actuales para identificar las mejores oportunidades de automatización y ahorro.",
  },
  {
    number: "02",
    icon: "lucide:code",
    title: "Diseño y Desarrollo",
    description:
      "Diseñamos e implementamos soluciones de IA a la medida, construyendo los flujos de trabajo que tu negocio necesita.",
  },
  {
    number: "03",
    icon: "lucide:cloud-upload",
    title: "Implementación y Despliegue",
    description:
      "Integramos las soluciones en tus sistemas existentes, garantizando una transición fluida y sin interrupciones.",
  },
  {
    number: "04",
    icon: "lucide:refresh-cw",
    title: "Optimización Continua",
    description:
      "Monitoreamos y optimizamos el rendimiento de la IA, asegurando que tus procesos operen con máxima eficiencia.",
  },
];
---

<section id="how-it-works" class="py-16 md:py-24 bg-slate-50 dark:bg-foreground">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="text-center mb-12 md:mb-16">
      <h2
        class="text-3xl md:text-5xl font-bold text-foreground leading-tight mb-4"
      >
        Nuestro Proceso de Transformación
      </h2>
      <p class="text-lg text-muted-foreground">
        Transformamos tus operaciones en solo cuatro pasos.
      </p>
    </div>

    <div class="relative px-8">
      <div
        class="absolute inset-y-0 left-1/2 w-0.5 -ml-0.5 bg-gray-200 dark:bg-gray-700 hidden lg:block"
      >
      </div>

      {
        steps.map((step, index) => (
          <div
            class={`relative mb-8 flex ${index % 2 === 0 ? "lg:flex-row" : "lg:flex-row-reverse"} items-center justify-center w-full`}
          >
            <div
              class={`w-full md:w-3/4 lg:w-1/2 ${index % 2 === 0 ? "lg:pr-20" : "lg:pl-8"} text-center lg:text-left`}
            >
              <div data-aos={index % 2 === 0 ? "fade-right" : "fade-left"}>
                <div class="flex items-center justify-center lg:justify-start gap-4 mb-4 lg:mb-0">
                  <h4 class="text-3xl font-bold text-indigo-600 dark:text-indigo-400">
                    {step.number}
                  </h4>

                  <div class="lg:hidden flex items-center justify-center p-2 rounded-full bg-indigo-600 dark:bg-indigo-500 text-white shadow-md">
                    <Icon name={step.icon} class="w-8 h-8" />
                  </div>
                </div>
                <Card className="relative bg-slate-50 border rounded-xl shadow-2xl overflow-hidden transform -rotate-1 hover:rotate-0 hover:shadow-2xl hover:scale-105 transition-transform duration-500">
                  <CardHeader>
                    <CardTitle className="text-2xl md:text-4xl font-extrabold text-primary">
                      {step.title}
                    </CardTitle>
                  </CardHeader>
                  <CardDescription className="px-6 pb-6 text-sm md:text-base text-accent-foreground">
                    {step.description}
                  </CardDescription>
                </Card>
              </div>
            </div>

            <div
              class={`hidden lg:flex items-center justify-center p-2 rounded-full bg-indigo-600 dark:bg-indigo-500 text-white z-20 shadow-md transform -translate-y-1/2 top-1/2 left-1/2 ${index % 2 === 0 ? "-ml-14" : "ml-14"}`}
            >
              <Icon name={step.icon} class="w-8 h-8" />
            </div>

            <div class="hidden lg:block w-1/2" />
          </div>
        ))
      }
    </div>
  </div>
</section>
