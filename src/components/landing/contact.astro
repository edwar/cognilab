---
import { Icon } from "astro-icon/components";
---

<section id="contact" class="py-20 md:py-32 px-4 relative overflow-hidden">
    <!-- Background Elements -->
    <div
        class="absolute inset-0 bg-gradient-to-b from-background via-primary/5 to-background"
    >
    </div>
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/10 rounded-full blur-3xl"
    >
    </div>

    <div class="container mx-auto px-4 max-w-4xl relative z-10">
        <div class="text-center mb-12">
            <div
                class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-4 backdrop-blur-sm"
            >
                <Icon name="lucide:mail" class="w-4 h-4 mr-2" />
                Contacto
            </div>
            <h2
                class="text-3xl md:text-5xl lg:text-6xl font-bold text-foreground leading-tight mb-6"
            >
                ¿Tienes una Idea o <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent"
                    >Necesitas Ayuda</span
                >?
            </h2>
            <p
                class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto"
            >
                ¿Quieres saber más sobre algún producto, reportar un problema o
                proponer una nueva funcionalidad? Estamos aquí para escucharte.
            </p>
        </div>

        <div
            class="bg-card/50 backdrop-blur-sm border border-border/50 rounded-2xl p-8 md:p-12 shadow-xl"
        >
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
                <div class="flex items-start gap-4">
                    <div class="p-3 bg-primary/10 rounded-lg">
                        <Icon name="lucide:mail" class="w-6 h-6 text-primary" />
                    </div>
                    <div>
                        <h3 class="font-bold text-foreground mb-1">Email</h3>
                        <a
                            href="mailto:edwaramayadiaz@gmail.com"
                            class="text-muted-foreground hover:text-primary transition-colors"
                        >
                            edwaramayadiaz@gmail.com
                        </a>
                    </div>
                </div>

                <div class="flex items-start gap-4">
                    <div class="p-3 bg-primary/10 rounded-lg">
                        <Icon
                            name="lucide:calendar"
                            class="w-6 h-6 text-primary"
                        />
                    </div>
                    <div>
                        <h3 class="font-bold text-foreground mb-1">
                            Agenda una Llamada
                        </h3>
                        <p class="text-muted-foreground">
                            Hablemos de tu proyecto
                        </p>
                    </div>
                </div>
            </div>

            <div class="pt-8 border-t border-border/40">
                <h3 class="text-xl font-bold text-foreground mb-6 text-center">
                    Envíanos un Mensaje
                </h3>
                <form class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label
                                for="name"
                                class="block text-sm font-medium text-foreground mb-2"
                                >Nombre</label
                            >
                            <input
                                type="text"
                                id="name"
                                name="name"
                                class="w-full px-4 py-3 bg-background border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary text-foreground"
                                placeholder="Tu nombre"
                                required
                            />
                        </div>
                        <div>
                            <label
                                for="email"
                                class="block text-sm font-medium text-foreground mb-2"
                                >Email</label
                            >
                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="w-full px-4 py-3 bg-background border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary text-foreground"
                                placeholder="tu@email.com"
                                required
                            />
                        </div>
                    </div>

                    <div>
                        <label
                            for="company"
                            class="block text-sm font-medium text-foreground mb-2"
                            >Empresa (Opcional)</label
                        >
                        <input
                            type="text"
                            id="company"
                            name="company"
                            class="w-full px-4 py-3 bg-background border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary text-foreground"
                            placeholder="Tu empresa"
                        />
                    </div>

                    <div>
                        <label
                            for="message"
                            class="block text-sm font-medium text-foreground mb-2"
                            >Mensaje</label
                        >
                        <textarea
                            id="message"
                            name="message"
                            rows="5"
                            class="w-full px-4 py-3 bg-background border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary text-foreground resize-none"
                            placeholder="Cuéntanos en qué podemos ayudarte..."
                            required></textarea>
                    </div>

                    <button
                        type="submit"
                        class="w-full inline-flex items-center justify-center px-8 py-4 text-base font-medium rounded-lg text-primary-foreground bg-primary hover:bg-primary/90 transition-all duration-200 shadow-glow hover:shadow-lg hover:-translate-y-1"
                    >
                        Enviar Mensaje
                        <Icon name="lucide:send" class="w-5 h-5 ml-2" />
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.querySelector("#contact form") as HTMLFormElement;

        if (form) {
            form.addEventListener("submit", (e) => {
                e.preventDefault();

                // Here you would typically send the form data to your backend
                // For now, we'll just show a simple alert
                const formData = new FormData(form);
                const data = Object.fromEntries(formData);

                console.log("Form submitted:", data);
                alert("¡Gracias por tu mensaje! Te contactaremos pronto.");
                form.reset();
            });
        }
    });
</script>
