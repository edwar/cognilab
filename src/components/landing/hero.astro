---
// Hero.astro — GSAP-powered hero with timeline entrance and floating orbs
---

<section
  id="home"
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-background"
  aria-labelledby="hero-heading"
>
  <!-- Animated mesh gradient background -->
  <div class="absolute inset-0 mesh-gradient"></div>
  <div class="absolute inset-0 bg-grid opacity-40"></div>

  <!-- Floating orbs — animated by GSAP -->
  <div class="orb absolute top-1/4 -left-32 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[120px]" aria-hidden="true"></div>
  <div class="orb absolute bottom-1/4 -right-32 w-[400px] h-[400px] bg-secondary/8 rounded-full blur-[100px]" aria-hidden="true"></div>
  <div class="orb absolute top-2/3 left-1/3 w-[300px] h-[300px] bg-accent/6 rounded-full blur-[80px]" aria-hidden="true"></div>

  <div class="absolute inset-0 scanlines pointer-events-none" aria-hidden="true"></div>

  <!-- Main Content -->
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Text Content -->
      <div class="lg:col-span-7 text-center lg:text-left">
        <div class="hero-badge inline-flex items-center gap-2.5 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 opacity-0">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary/60"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
          </span>
          <span class="text-xs font-mono font-medium text-primary tracking-wider uppercase">Estudio de Productos SaaS</span>
        </div>

        <h1 id="hero-heading" class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-extrabold tracking-tight leading-[0.95] mt-8 mb-6">
          <span class="hero-line block text-foreground overflow-hidden"><span class="inline-block">Productos</span></span>
          <span class="hero-line block gradient-text overflow-hidden"><span class="inline-block">SaaS</span></span>
          <span class="hero-line block text-foreground overflow-hidden"><span class="inline-block">que Resuelven</span></span>
          <span class="hero-line block text-foreground overflow-hidden"><span class="inline-block">Problemas <span class="text-accent">Reales</span></span></span>
        </h1>

        <p class="hero-sub text-lg sm:text-xl text-muted-foreground mb-10 max-w-xl mx-auto lg:mx-0 leading-relaxed opacity-0">
          Creamos plataformas modernas para optimizar tu negocio: agendamiento inteligente, gestión empresarial, punto de venta y experiencias gamificadas.
        </p>

        <div class="hero-ctas flex flex-col sm:flex-row gap-4 justify-center lg:justify-start opacity-0">
          <a href="#projects" class="group inline-flex items-center justify-center gap-3 px-8 py-4 text-base font-semibold rounded-2xl bg-primary text-primary-foreground transition-all duration-300 hover:shadow-[0_0_40px_oklch(0.78_0.15_195/0.35)] hover:-translate-y-0.5">
            Ver Productos
            <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="#contact" class="inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-semibold rounded-2xl text-foreground border border-border/50 bg-white/[0.02] hover:bg-white/[0.05] hover:border-border transition-all duration-300 backdrop-blur-sm">
            Contáctanos
          </a>
        </div>

        <div class="hero-tech mt-14 pt-8 border-t border-border/30 opacity-0">
          <p class="text-[0.65rem] font-mono font-medium text-muted-foreground/50 tracking-[0.25em] uppercase mb-5">Construido con</p>
          <div class="tech-stack flex flex-wrap justify-center lg:justify-start gap-x-7 gap-y-3">
            {[
              { name: "Next.js", icon: "N" },
              { name: "TypeScript", icon: "TS" },
              { name: "Neon", icon: "▲" },
              { name: "Tailwind", icon: "◆" },
            ].map((tech) => (
              <div class="tech-item flex items-center gap-2 opacity-0">
                <span class="flex h-7 w-7 items-center justify-center rounded-md bg-white/5 border border-white/5 text-[0.6rem] font-mono font-bold text-primary/70 hover:text-primary hover:bg-primary/10 transition-all duration-300">
                  {tech.icon}
                </span>
                <span class="text-sm font-medium text-muted-foreground/60">{tech.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Terminal mockup -->
      <div class="lg:col-span-5 relative hidden lg:block">
        <div class="terminal-wrapper opacity-0">
          <div class="relative rounded-2xl border border-border/50 bg-card/50 backdrop-blur-xl overflow-hidden shadow-2xl shadow-black/40">
            <div class="flex items-center gap-2 px-4 py-3 border-b border-border/30 bg-white/[0.02]">
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
              </div>
              <span class="ml-3 text-xs font-mono text-muted-foreground/50">cognilab_products.ts</span>
            </div>

            <div class="p-5 font-mono text-sm min-h-[380px]">
              <div class="space-y-3">
                <div class="flex items-center gap-2 text-primary">
                  <span class="animate-pulse">●</span>
                  <span class="text-xs">System Online</span>
                </div>
                <div class="space-y-2 text-muted-foreground/70 text-xs">
                  <p><span class="text-green-400">&gt;</span> VLink — agendamiento online</p>
                  <p><span class="text-cyan-400">&gt;</span> Loki — gestión empresarial</p>
                  <p><span class="text-amber-400">&gt;</span> Hermes — POS + DIAN</p>
                  <p><span class="text-primary">&gt;</span> Thor — sorteos gamificados</p>
                </div>
                <div class="mt-4 p-3 rounded-lg bg-primary/5 border border-primary/10">
                  <div class="flex justify-between text-xs text-muted-foreground/50 mb-2">
                    <span>Productos activos</span>
                    <span class="text-primary font-semibold">4</span>
                  </div>
                  <div class="w-full bg-white/5 h-1.5 rounded-full overflow-hidden">
                    <div class="terminal-progress h-full bg-gradient-to-r from-primary to-secondary rounded-full w-0"></div>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3 mt-3">
                  <div class="p-2.5 rounded-lg bg-white/[0.02] border border-border/30">
                    <div class="text-[0.6rem] text-muted-foreground/40 uppercase tracking-wider mb-1">Stack</div>
                    <div class="text-sm font-bold text-foreground">Next.js</div>
                  </div>
                  <div class="p-2.5 rounded-lg bg-white/[0.02] border border-border/30">
                    <div class="text-[0.6rem] text-muted-foreground/40 uppercase tracking-wider mb-1">Infra</div>
                    <div class="text-sm font-bold text-foreground">Neon</div>
                  </div>
                </div>
                <div class="mt-3 text-[0.7rem] text-muted-foreground/40 leading-relaxed font-mono">
                  <div><span class="text-secondary">const</span> products = [</div>
                  <div class="pl-3" set:html='&#123; name: <span class="text-primary">"VLink"</span>, status: <span class="text-green-400">"live"</span> &#125;,'></div>
                  <div class="pl-3" set:html='&#123; name: <span class="text-primary">"Loki"</span>, status: <span class="text-green-400">"live"</span> &#125;,'></div>
                  <div class="pl-3" set:html='&#123; name: <span class="text-primary">"Hermes"</span>, status: <span class="text-green-400">"live"</span> &#125;,'></div>
                  <div class="pl-3" set:html='&#123; name: <span class="text-primary">"Thor"</span>, status: <span class="text-green-400">"live"</span> &#125;,'></div>
                  <div>];</div>
                </div>
              </div>
            </div>
          </div>
          <div class="absolute -inset-4 bg-primary/5 rounded-3xl blur-2xl -z-10"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0">
    <span class="text-[0.6rem] font-mono text-muted-foreground/40 tracking-[0.3em] uppercase">Scroll</span>
    <div class="w-5 h-8 rounded-full border border-border/30 flex justify-center pt-1.5">
      <div class="w-1 h-2 rounded-full bg-primary/50 animate-bounce"></div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!prefersReducedMotion) {
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

    tl.to(".hero-badge", { opacity: 1, y: 0, duration: 0.6 }, 0.2)
      .to(".hero-line span", { y: 0, duration: 0.9, stagger: 0.12 }, 0.3)
      .to(".hero-sub", { opacity: 1, y: 0, duration: 0.7 }, 0.8)
      .to(".hero-ctas", { opacity: 1, y: 0, duration: 0.6 }, 1.0)
      .to(".hero-tech", { opacity: 1, y: 0, duration: 0.6 }, 1.1)
      .to(".tech-item", { opacity: 1, y: 0, duration: 0.4, stagger: 0.08 }, 1.2)
      .to(".terminal-wrapper", { opacity: 1, x: 0, duration: 1, ease: "power2.out" }, 0.5)
      .to(".terminal-progress", { width: "100%", duration: 1.5, ease: "power2.inOut" }, 1.2)
      .to(".scroll-indicator", { opacity: 1, duration: 0.5 }, 1.8);

    // Set initial states
    gsap.set(".hero-line span", { yPercent: 100 });
    gsap.set(".hero-sub", { y: 20 });
    gsap.set(".hero-ctas", { y: 20 });
    gsap.set(".hero-tech", { y: 20 });
    gsap.set(".tech-item", { y: 15 });
    gsap.set(".terminal-wrapper", { x: 40 });

    // Floating orbs continuous animation
    gsap.to(".orb", {
      y: "random(-40, 40)",
      x: "random(-30, 30)",
      scale: "random(0.95, 1.05)",
      duration: "random(6, 10)",
      repeat: -1,
      yoyo: true,
      ease: "sine.inOut",
      stagger: { each: 1.5, from: "random" },
    });
  }
</script>
