---
// Hero.astro
---

<section
  id="home"
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-background"
  aria-labelledby="hero-heading"
>
  <!-- Background Elements -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"
  >
  </div>
  <div
    class="absolute inset-0 bg-grid-black/[0.02] bg-[size:50px_50px]"
    aria-hidden="true"
  >
  </div>

  <!-- Animated Glows -->
  <div
    class="absolute top-1/4 -left-20 w-96 h-96 bg-primary/20 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob will-change-transform"
  >
  </div>
  <div
    class="absolute top-1/3 -right-20 w-96 h-96 bg-secondary/15 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-2000 will-change-transform"
  >
  </div>
  <div
    class="absolute -bottom-32 left-1/3 w-96 h-96 bg-accent/15 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-4000 will-change-transform"
  >
  </div>

  <!-- Main Content -->
  <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Text Content -->
      <div class="lg:col-span-7 text-center lg:text-left pt-10 lg:pt-0">
        <!-- Badge -->
        <div
          class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-6 backdrop-blur-sm"
        >
          <span class="flex h-2 w-2 rounded-full bg-primary mr-2 animate-pulse"
          ></span>
          Estudio de Productos SaaS
        </div>

        <!-- Headline -->
        <h1
          id="hero-heading"
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-foreground mb-6 leading-tight text-balance"
        >
          Productos <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-accent to-secondary animate-gradient-x"
            >SaaS</span
          > que Resuelven Problemas Reales
        </h1>

        <!-- Subheadline -->
        <p
          class="text-lg sm:text-xl text-muted-foreground mb-8 max-w-2xl mx-auto lg:mx-0 leading-relaxed text-balance"
        >
          En CogniLab creamos plataformas modernas para optimizar tu negocio:
          agendamiento inteligente, gestión empresarial, punto de venta y
          experiencias gamificadas — todo en un solo ecosistema.
        </p>

        <!-- CTAs -->
        <div
          class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
        >
          <a
            href="#projects"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-medium rounded-lg text-primary-foreground bg-primary hover:bg-primary/90 transition-all duration-200 shadow-glow hover:shadow-lg hover:-translate-y-1"
          >
            Ver Productos
            <svg
              class="w-5 h-5 ml-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
            >
          </a>
          <a
            href="#contact"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-medium rounded-lg text-foreground bg-secondary/10 border border-secondary/20 hover:bg-secondary/20 transition-all duration-200 backdrop-blur-sm"
          >
            Contáctanos
          </a>
        </div>

        <!-- Tech Stack / Trust -->
        <div class="mt-12 pt-8 border-t border-border/40">
          <p class="text-sm text-muted-foreground mb-4 font-mono">
            CONSTRUIDO CON
          </p>
          <div
            class="flex flex-wrap justify-center lg:justify-start gap-6 opacity-70 grayscale hover:grayscale-0 transition-all duration-500"
          >
            <span class="font-bold text-xl flex items-center gap-2"
              ><span class="i-lucide-globe"></span> Next.js</span
            >
            <span class="font-bold text-xl flex items-center gap-2"
              ><span class="i-lucide-code-2"></span> TypeScript</span
            >
            <span class="font-bold text-xl flex items-center gap-2"
              ><span class="i-lucide-database"></span> Neon</span
            >
            <span class="font-bold text-xl flex items-center gap-2"
              ><span class="i-lucide-palette"></span> TailwindCSS</span
            >
          </div>
        </div>
      </div>

      <!-- Visual Content -->
      <div class="lg:col-span-5 relative hidden lg:block">
        <div
          class="relative z-10 transform perspective-1000 hover:rotate-y-12 transition-transform duration-700 ease-out"
        >
          <!-- Abstract AI Interface Mockup -->
          <div
            class="relative bg-card border border-primary/20 rounded-xl shadow-xl overflow-hidden"
          >
            <!-- Window Controls -->
            <div
              class="bg-muted px-4 py-3 border-b border-border flex items-center space-x-2"
            >
              <div class="w-3 h-3 bg-red-500/80 rounded-full"></div>
              <div class="w-3 h-3 bg-yellow-500/80 rounded-full"></div>
              <div class="w-3 h-3 bg-green-500/80 rounded-full"></div>
              <div class="ml-4 text-xs text-foreground/60 font-mono">
                cognilab_products.ts
              </div>
            </div>

            <!-- Code/Interface Content -->
            <div
              class="p-6 font-mono text-sm relative overflow-hidden min-h-[400px] bg-muted/30"
            >

              <div class="space-y-4">
                <div class="flex items-center gap-2 text-green-400">
                  <span class="animate-pulse">●</span>
                  <span>System Online</span>
                </div>

                <div class="space-y-2 text-muted-foreground">
                  <p class="text-green-400">> VLink — agendamiento online</p>
                  <p class="text-cyan-400">> Loki — gestión empresarial</p>
                  <p class="text-yellow-400">> Hermes — POS + DIAN</p>
                  <p class="text-primary">> Thor — sorteos gamificados</p>
                </div>

                <div
                  class="mt-6 p-4 bg-primary/5 rounded border border-primary/20"
                >
                  <div
                    class="flex justify-between text-xs text-muted-foreground mb-2"
                  >
                    <span>Productos activos</span>
                    <span>4</span>
                  </div>
                  <div
                    class="w-full bg-muted/30 h-1.5 rounded-full overflow-hidden"
                  >
                    <div class="h-full bg-primary w-full animate-pulse">
                    </div>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-4 mt-4">
                  <div
                    class="p-3 bg-secondary/5 rounded border border-secondary/20"
                  >
                    <div class="text-xs text-secondary mb-1">
                      Tech Stack
                    </div>
                    <div class="text-lg font-bold text-foreground">Next.js</div>
                  </div>
                  <div class="p-3 bg-accent/5 rounded border border-accent/20">
                    <div class="text-xs text-accent mb-1">Infra</div>
                    <div class="text-lg font-bold text-foreground">Neon</div>
                  </div>
                </div>

                <!-- Floating Code Snippet -->
                <div class="mt-6 text-xs text-blue-300 opacity-80">
                  <div>
                    <span class="text-purple-400">const</span> products = [<span class="text-yellow-300"> </span>
                  </div>
                  <div class="pl-4">
                    &#123; name: <span class="text-green-400">"VLink"</span>, status: <span class="text-green-400">"live"</span> &#125;,
                  </div>
                  <div class="pl-4">
                    &#123; name: <span class="text-green-400">"Loki"</span>, status: <span class="text-green-400">"live"</span> &#125;,
                  </div>
                  <div class="pl-4">
                    &#123; name: <span class="text-green-400">"Hermes"</span>, status: <span class="text-green-400">"live"</span> &#125;,
                  </div>
                  <div class="pl-4">
                    &#123; name: <span class="text-green-400">"Thor"</span>, status: <span class="text-green-400">"live"</span> &#125;
                  </div>
                  <div>];</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating Elements behind -->
        <div
          class="absolute -top-10 -right-10 w-32 h-32 bg-primary/20 rounded-full blur-xl animate-pulse"
        >
        </div>
        <div
          class="absolute -bottom-10 -left-10 w-32 h-32 bg-secondary/20 rounded-full blur-xl animate-pulse delay-1000"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bg-grid-black\/\[0\.02\] {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' width='32' height='32' fill='none' stroke='rgb(0 0 0 / 0.04)'%3e%3cpath d='M0 .5H31.5V32'/%3e%3c/svg%3e");
  }

  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }

  .animate-blob {
    animation: blob 7s infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }

  .perspective-1000 {
    perspective: 1000px;
  }

  @keyframes gradient-x {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .animate-gradient-x {
    background-size: 200% 200%;
    animation: gradient-x 4s ease infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-blob {
      animation: none;
    }
    .animate-gradient-x {
      animation: none;
    }
  }
</style>
