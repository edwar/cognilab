---
// Hero.astro
---

<section 
  id="home" 
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-background via-background to-muted/20"
  aria-labelledby="hero-heading"
>
  <!-- Background Pattern -->
  <div class="absolute inset-0 bg-grid-slate-100 [mask-image:linear-gradient(0deg,transparent,black)] dark:bg-grid-slate-700/25" aria-hidden="true"></div>
  
  <!-- Background Blur Elements -->
  <div class="absolute top-0 -left-4 w-72 h-72 bg-primary/10 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob" aria-hidden="true"></div>
  <div class="absolute top-0 -right-4 w-72 h-72 bg-accent/20 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-2000" aria-hidden="true"></div>
  <div class="absolute -bottom-8 left-20 w-72 h-72 bg-secondary/20 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-4000" aria-hidden="true"></div>

  <!-- Main Content -->
  <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Text Content -->
      <div class="lg:col-span-6 text-center lg:text-left">
        <!-- Badge/Announcement -->
        <div class="inline-flex items-center rounded-full border px-3 py-1 text-sm font-medium bg-muted/50 text-muted-foreground mb-6 hover:bg-muted/80 transition-colors">
          <span class="relative flex h-2 w-2 mr-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
          </span>
          Nuevo: Funcionalidades avanzadas
        </div>

        <!-- Main Headline -->
        <h1 
          id="hero-heading" 
          class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-foreground mb-6 leading-tight"
        >
          Transforma tu 
          <span class="text-primary relative">
            negocio
            <svg class="absolute -bottom-1 left-0 w-full h-3 text-foreground" aria-hidden="true">
              <path d="M 10 10 C 50 8, 150 12, 190 10" 
                    stroke="currentColor" 
                    stroke-width="4" 
                    fill="currentColor" 
                    stroke-linecap="round" />
            </svg>
          </span>
          con nuestras soluciones
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-muted-foreground mb-8 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Automatiza tus procesos, mejora la productividad y escala tu empresa con nuestras soluciones integradas diseñadas para el éxito empresarial.
        </p>

        <!-- Social Proof Numbers -->
        <div class="grid grid-cols-3 gap-6 text-center lg:text-left">
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-foreground">5,000+</div>
            <div class="text-sm text-muted-foreground">Empresas confían</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-foreground">99.9%</div>
            <div class="text-sm text-muted-foreground">Uptime garantizado</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-bold text-foreground">24/7</div>
            <div class="text-sm text-muted-foreground">Soporte técnico</div>
          </div>
        </div>
      </div>

      <!-- Visual Content -->
      <div class="lg:col-span-6 relative">
        <!-- Main Hero Image/Mockup -->
        <div class="relative z-10">
          <!-- Dashboard Mockup Container -->
          <div class="relative bg-background border rounded-xl shadow-2xl overflow-hidden transform rotate-1 hover:rotate-0 transition-transform duration-500">
            <div class="bg-muted/30 px-4 py-3 border-b flex items-center space-x-2">
              <div class="w-3 h-3 bg-red-500 rounded-full"></div>
              <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
              <div class="w-3 h-3 bg-green-500 rounded-full"></div>
              <div class="flex-1 text-center text-sm text-muted-foreground">tuapp.com</div>
            </div>
            
            <!-- Mock Dashboard Content -->
            <div class="p-6 bg-gradient-to-br from-background to-muted/10">
              <!-- Header -->
              <div class="flex items-center justify-between mb-6">
                <h3 class="text-lg font-semibold">Panel de Control</h3>
                <div class="flex space-x-2">
                  <div class="w-8 h-8 bg-primary/10 rounded-md"></div>
                  <div class="w-8 h-8 bg-accent/20 rounded-md"></div>
                </div>
              </div>
              
              <!-- Stats Cards -->
              <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="bg-muted/20 p-4 rounded-lg">
                  <div class="w-full h-2 bg-primary/30 rounded-full mb-2">
                    <div class="w-11/12 h-full bg-primary rounded-full"></div>
                  </div>
                  <div class="text-sm text-muted-foreground">Productividad</div>
                </div>
                <div class="bg-muted/20 p-4 rounded-lg">
                  <div class="w-full h-2 bg-primary/30 rounded-full mb-2">
                      <div class="w-11/12 h-full bg-primary rounded-full"></div>
                  </div>
                  <div class="text-sm text-muted-foreground">Eficiencia</div>
                </div>
              </div>
              
              <!-- Chart Mockup -->
              <div class="bg-muted/20 rounded-lg p-4">
                <div class="flex items-end space-x-2 h-20">
                  <div class="w-4 bg-primary/60 h-12 rounded-t animate-bounce animation-delay-500"></div>
                  <div class="w-4 bg-primary/80 h-16 rounded-t animate-bounce animation-delay-700"></div>
                  <div class="w-4 bg-primary h-20 rounded-t animate-bounce animation-delay-1000"></div>
                  <div class="w-4 bg-primary/90 h-14 rounded-t animate-bounce animation-delay-1200"></div>
                  <div class="w-4 bg-primary/70 h-18 rounded-t animate-bounce animation-delay-1500"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating Elements -->
        <div class="absolute -top-4 -right-4 w-20 h-20 bg-primary/20 rounded-full blur-sm animate-bounce animation-delay-2000" aria-hidden="true"></div>
        <div class="absolute -bottom-4 -left-4 w-16 h-16 bg-accent/30 rounded-full blur-sm animate-bounce animation-delay-3000" aria-hidden="true"></div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute -bottom-24 left-1/2 transform -translate-x-1/2 text-center">
      <div class="flex flex-col justify-center items-center space-x-2">
        <div class="text-sm text-muted-foreground mb-2 font-semibold uppercase">Descubre más</div>
        <div class="w-6 h-10 border border-muted-foreground rounded-full flex justify-center">
          <div class="w-1 h-5 bg-muted-foreground rounded-full animate-bounce mt-3"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const demoButton = document.querySelector('.demo-button') as HTMLButtonElement;
    
    if (demoButton) {
      demoButton.addEventListener('click', function() {
        // Aquí puedes agregar lógica para mostrar un modal de demo
        // o redirigir a una página de demo
        console.log('Demo button clicked');
        
        // Ejemplo: mostrar alerta temporal
        const originalText = demoButton.innerHTML;
        demoButton.innerHTML = '✓ Demo solicitado';
        demoButton.disabled = true;
        
        setTimeout(() => {
          demoButton.innerHTML = originalText;
          demoButton.disabled = false;
        }, 2000);
      });
    }

    // Smooth scroll for CTA button
    const ctaButton = document.querySelector('a[href="#funcionalidades"]');
    ctaButton?.addEventListener('click', function(e) {
      e.preventDefault();
      const target = document.querySelector('#funcionalidades');
      target?.scrollIntoView({ 
        behavior: 'smooth',
        block: 'start'
      });
    });

    // Intersection Observer for animations on scroll
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in');
        }
      });
    }, observerOptions);

    // Observe hero elements for animation
    const heroElements = document.querySelectorAll('#inicio > div > div > div');
    heroElements.forEach(el => observer.observe(el));
  });
</script>

<style>
  /* Background Grid Pattern */
  .bg-grid-slate-100 {
    background-image: url("data:image/svg+xml,%3csvg width='40' height='40' xmlns='http://www.w3.org/2000/svg'%3e%3cdefs%3e%3cpattern id='grid' width='40' height='40' patternUnits='userSpaceOnUse'%3e%3cpath d='M 40 0 L 0 0 0 40' fill='none' stroke='%23e2e8f0' stroke-width='1'/%3e%3c/pattern%3e%3c/defs%3e%3crect width='100%25' height='100%25' fill='url(%23grid)' /%3e%3c/svg%3e");
  }
  
  .dark .bg-grid-slate-700\/25 {
    background-image: url("data:image/svg+xml,%3csvg width='40' height='40' xmlns='http://www.w3.org/2000/svg'%3e%3cdefs%3e%3cpattern id='grid' width='40' height='40' patternUnits='userSpaceOnUse'%3e%3cpath d='M 40 0 L 0 0 0 40' fill='none' stroke='%23374151' stroke-width='1' stroke-opacity='0.25'/%3e%3c/pattern%3e%3c/defs%3e%3crect width='100%25' height='100%25' fill='url(%23grid)' /%3e%3c/svg%3e");
  }

  /* Blob Animation */
  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }
  
  .animate-blob {
    animation: blob 7s infinite;
  }
  
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  
  .animation-delay-4000 {
    animation-delay: 4s;
  }

  .animation-delay-500 {
    animation-delay: 0.5s;
  }

  .animation-delay-700 {
    animation-delay: 0.7s;
  }

  .animation-delay-1000 {
    animation-delay: 1s;
  }

  .animation-delay-1200 {
    animation-delay: 1.2s;
  }

  .animation-delay-1500 {
    animation-delay: 1.5s;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-3000 {
    animation-delay: 3s;
  }

  /* Fade in animation */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fadeIn 0.6s ease-out;
  }

  /* Reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .animate-blob,
    .animate-bounce,
    .animate-ping,
    .animate-pulse {
      animation: none;
    }
    
    * {
      transition-duration: 0.01ms !important;
    }
  }
</style>