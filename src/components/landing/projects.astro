---
import { Icon } from "astro-icon/components";

// Array de proyectos - Agrega o edita proyectos aquí
const projects = [
    {
        title: "Sistema de Gestion de Delivery",
        description:
            "Plataforma potenciada por AI que optimiza el flujo de operaciones de delivery.",
        image: "/projects/delivery.png", // Ruta a la imagen del proyecto
        tags: [
            "AI",
            "N8N",
            "NextJS",
            "TailwindCSS",
            "TypeScript",
            "Supabase",
            "Redis",
            "Vercel",
            "Evolution API",
        ],
        link: "https://delivery.cognilab.dev", // Link al proyecto o caso de estudio
    },
    {
        title: "Sistema de optimización de rutas",
        description:
            "Herramienta de optimización de rutas más sencilla y potente. Ahorra tiempo, dinero y estrés en cada entrega.",
        image: "/projects/zas.png", // Ruta a la imagen del proyecto
        tags: ["Astro", "TailwindCSS", "TypeScript", "Supabase", "Vercel"],
        link: "https://zas.cognilab.dev", // Link al proyecto o caso de estudio
    },
    {
        title: "Sistema de planeación de sprint",
        description:
            "Herramienta de planeación de sprint más sencilla y potente. Ahorra tiempo, dinero y estrés en cada entrega.",
        image: "/projects/planning-poker.png", // Ruta a la imagen del proyecto
        tags: ["NextJS", "TailwindCSS", "TypeScript", "Firebase", "Vercel"],
        link: "https://planning-poker.cognilab.dev", // Link al proyecto o caso de estudio
    },
];
---

<section id="projects" class="py-20 md:py-32 px-4 relative overflow-hidden">
    <!-- Background Elements -->
    <div
        class="absolute inset-0 bg-gradient-to-b from-background via-muted/10 to-background"
    >
    </div>
    <div
        class="absolute top-1/2 right-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl"
    >
    </div>

    <div class="container mx-auto px-4 max-w-7xl relative z-10">
        <div class="text-center mb-16">
            <div
                class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-4 backdrop-blur-sm"
            >
                <Icon name="lucide:briefcase" class="w-4 h-4 mr-2" />
                Proyectos
            </div>
            <h2
                class="text-3xl md:text-5xl lg:text-6xl font-bold text-foreground leading-tight mb-6"
            >
                Casos de <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent"
                    >Éxito</span
                >
            </h2>
            <p
                class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto"
            >
                Descubre cómo hemos ayudado a empresas a transformar sus
                operaciones con soluciones de IA.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
                projects.map((project, index) => (
                    <a
                        href={project.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group relative bg-card/50 backdrop-blur-sm border border-border/50 hover:border-primary/50 rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-primary/10 hover:-translate-y-2"
                    >
                        {/* Image Container */}
                        <div class="relative  overflow-hidden bg-muted/20">
                            <img
                                src={project.image}
                                alt={project.title}
                                class="w-full h-full object-cover aspect-auto"
                            />

                            {/* Overlay on hover */}
                            <div class="absolute inset-0 bg-gradient-to-t from-background via-background/50 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-300" />

                            {/* Project number badge */}
                            <div class="absolute top-4 right-4 w-12 h-12 bg-primary/20 backdrop-blur-sm border border-primary/30 rounded-full flex items-center justify-center">
                                <span class="text-primary font-bold text-lg">
                                    {String(index + 1).padStart(2, "0")}
                                </span>
                            </div>
                        </div>

                        {/* Content */}
                        <div class="p-6">
                            <h3 class="text-xl md:text-2xl font-bold text-foreground mb-3 group-hover:text-primary transition-colors duration-300">
                                {project.title}
                            </h3>
                            <p class="text-muted-foreground leading-relaxed mb-4">
                                {project.description}
                            </p>

                            {/* Tags */}
                            <div class="flex flex-wrap gap-2 mb-4">
                                {project.tags.map((tag) => (
                                    <span class="px-3 py-1 bg-primary/10 text-primary text-xs font-medium rounded-full border border-primary/20">
                                        {tag}
                                    </span>
                                ))}
                            </div>

                            {/* CTA */}
                            <div class="flex items-center text-primary font-medium group-hover:gap-2 transition-all duration-300">
                                <span>Ver proyecto</span>
                                <Icon
                                    name="lucide:arrow-right"
                                    class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300"
                                />
                            </div>
                        </div>

                        {/* Glow effect on hover */}
                        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />
                    </a>
                ))
            }
        </div>

        <!-- CTA -->
        <div class="mt-16 text-center">
            <a
                href="#contact"
                class="inline-flex items-center justify-center px-8 py-4 text-base font-medium rounded-lg text-primary-foreground bg-primary hover:bg-primary/90 transition-all duration-200 shadow-glow hover:shadow-lg hover:-translate-y-1"
            >
                Hablemos de tu Proyecto
                <Icon name="lucide:arrow-right" class="w-5 h-5 ml-2" />
            </a>
        </div>
    </div>
</section>

<style>
    /* Ensure images cover the container properly when added */
    img {
        object-fit: cover;
        width: 100%;
        height: 100%;
    }
</style>
