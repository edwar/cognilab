---
import { Icon } from "astro-icon/components";

const projects = [
    {
        title: "VLink",
        subtitle: "Agendamiento Profesional",
        description:
            "Plataforma de agendamiento que automatiza citas, coordina equipos y sincroniza calendarios en tiempo real con Google Calendar.",
        image: "/projects/vlink.png",
        tags: ["NextJS", "TypeScript", "TailwindCSS", "Neon", "Google Calendar API"],
        link: "https://vlink.cognilab.dev",
        color: "primary",
    },
    {
        title: "Loki",
        subtitle: "Gestión Empresarial",
        description:
            "Sistema todo-en-uno para emprendedores: ventas, inventario, gastos, fidelización de clientes y métricas avanzadas.",
        image: "/projects/loki.png",
        tags: ["NextJS", "TypeScript", "TailwindCSS", "Neon", "PostgreSQL"],
        link: "https://loki.cognilab.dev",
        color: "secondary",
    },
    {
        title: "Hermes",
        subtitle: "POS y Facturación Electrónica",
        description:
            "Sistema POS moderno con facturación electrónica DIAN, gestión de inventario, reportes y soporte offline para Colombia.",
        image: "/projects/hermes.png",
        tags: ["NextJS", "TypeScript", "TailwindCSS", "Neon", "DIAN API"],
        link: "https://hermes.cognilab.dev",
        color: "accent",
    },
    {
        title: "Thor",
        subtitle: "Sorteos Gamificados en Vivo",
        description:
            "Plataforma SaaS de sorteos con ruleta en vivo, aleatoriedad SHA-256 verificable y pagos locales Wompi/Bold.",
        image: "/projects/thor.png",
        tags: ["NextJS", "TypeScript", "TailwindCSS", "Neon", "Wompi"],
        link: "https://thor.cognilab.dev",
        color: "primary",
    },
    {
        title: "Apolo",
        subtitle: "Vectorización Inteligente con IA",
        description:
            "Laboratorio de vectorización que convierte imágenes rasterizadas en SVG de alta fidelidad usando análisis automático y pipelines dinámicos.",
        image: "/projects/apolo.png",
        tags: ["Astro", "React", "TypeScript", "Fastify", "Sharp"],
        link: "https://github.com/edwar/apolo",
        color: "secondary",
    },
    {
        title: "Atenea",
        subtitle: "Gestión Segura de API Keys",
        description:
            "Plataforma de gestión de claves API con cifrado AES-256-GCM, control de acceso por roles, auditoría completa y autenticación 2FA.",
        image: "/projects/atenea.png",
        tags: ["NextJS", "TypeScript", "Prisma", "PostgreSQL", "better-auth"],
        link: "https://github.com/edwar/atenea",
        color: "accent",
    },
    {
        title: "Nabu",
        subtitle: "Scraping Web con IA",
        description:
            "Plataforma SaaS de scraping que usa LLM para extraer datos estructurados de cualquier sitio web a partir de descripciones en lenguaje natural.",
        image: "/projects/nabu.png",
        tags: ["NextJS", "TypeScript", "Prisma", "Groq", "Cheerio"],
        link: "https://github.com/edwar/nabu",
        color: "primary",
    },
    {
        title: "Perseus",
        subtitle: "Finanzas Personales Inteligentes",
        description:
            "Gestor financiero personal con OCR inteligente para escaneo de recibos, categorización automática con IA, presupuestos y metas de ahorro.",
        image: "/projects/perseus.png",
        tags: ["NextJS", "TypeScript", "Prisma", "Neon", "Groq"],
        link: "https://github.com/edwar/perseus",
        color: "secondary",
    },
];

const colorAccent: Record<string, string> = {
    primary: "text-primary",
    secondary: "text-secondary",
    accent: "text-accent",
};

const colorBg: Record<string, string> = {
    primary: "bg-primary/10 border-primary/20",
    secondary: "bg-secondary/10 border-secondary/20",
    accent: "bg-accent/10 border-accent/20",
};
---

<section id="projects" class="py-20 md:py-32 px-4 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-background via-muted/10 to-background"></div>
    <div class="absolute top-1/2 right-1/4 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[120px]" aria-hidden="true"></div>

    <div class="container mx-auto px-4 max-w-7xl relative z-10">
        <div class="text-center mb-16" data-gsap="reveal">
            <div class="inline-flex items-center rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-xs font-mono font-medium text-primary tracking-wider uppercase mb-6">
                <Icon name="lucide:briefcase" class="w-3.5 h-3.5 mr-2" />
                Proyectos
            </div>
            <h2 class="font-display text-3xl md:text-5xl lg:text-6xl font-extrabold text-foreground leading-tight mb-6">
                Casos de <span class="gradient-text">Éxito</span>
            </h2>
            <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto">
                Descubre cómo hemos ayudado a empresas a transformar sus operaciones con soluciones de IA.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-gsap="stagger">
            {
                projects.map((project, index) => (
                    <a
                        href={project.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="project-card group relative bg-card/30 backdrop-blur-sm border border-border/30 rounded-2xl overflow-hidden transition-all duration-500 hover:border-border/60 hover:shadow-xl hover:-translate-y-1"
                    >
                        {/* Image */}
                        <div class="relative overflow-hidden bg-muted/10 aspect-video">
                            <img
                                src={project.image}
                                alt={project.title}
                                loading="lazy"
                                decoding="async"
                                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-card via-card/40 to-transparent opacity-70 group-hover:opacity-50 transition-opacity duration-500" />
                            
                            {/* Number badge */}
                            <div class={`absolute top-4 right-4 w-10 h-10 ${colorBg[project.color]} backdrop-blur-sm rounded-full flex items-center justify-center border`}>
                                <span class={`${colorAccent[project.color]} font-mono font-bold text-sm`}>
                                    {String(index + 1).padStart(2, "0")}
                                </span>
                            </div>

                            {/* Hover arrow */}
                            <div class="absolute bottom-4 right-4 w-10 h-10 bg-primary rounded-full flex items-center justify-center opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-400">
                                <Icon name="lucide:arrow-up-right" class="w-5 h-5 text-primary-foreground" />
                            </div>
                        </div>

                        {/* Content */}
                        <div class="p-6">
                            <div class="flex items-baseline gap-3 mb-2">
                                <h3 class={`font-display text-xl font-bold ${colorAccent[project.color]} transition-colors duration-300`}>
                                    {project.title}
                                </h3>
                                <span class="text-xs font-mono text-muted-foreground/50">{project.subtitle}</span>
                            </div>
                            <p class="text-sm text-muted-foreground leading-relaxed mb-4">
                                {project.description}
                            </p>
                            <div class="flex flex-wrap gap-1.5">
                                {project.tags.map((tag) => (
                                    <span class="px-2.5 py-0.5 bg-white/[0.03] text-muted-foreground/60 text-[0.65rem] font-mono rounded-md border border-border/20">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>

        <div class="mt-16 text-center" data-gsap="reveal">
            <a
                href="#contact"
                class="group inline-flex items-center gap-2 px-8 py-4 text-base font-semibold rounded-2xl bg-primary text-primary-foreground transition-all duration-300 hover:shadow-[0_0_30px_oklch(0.78_0.15_195/0.3)] hover:-translate-y-0.5"
            >
                Contáctanos
                <Icon name="lucide:arrow-right" class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
        </div>
    </div>
</section>
