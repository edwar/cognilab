---
// Navbar.astro — Glassmorphic sticky nav with scroll-aware opacity
---

<header
  role="banner"
  class="navbar-glass fixed top-0 left-0 right-0 z-50 w-full transition-all duration-500"
>
  <nav role="navigation" aria-label="Navegación principal">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between lg:h-20">
        <!-- Logo -->
        <a
          href="/#home"
          class="group flex items-center gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-xl"
          aria-label="Ir al inicio — CogniLab"
        >
          <div class="relative flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 border border-primary/20 group-hover:bg-primary/20 group-hover:border-primary/40 transition-all duration-300">
            <span class="font-display text-primary font-bold text-lg">C</span>
            <div class="absolute -top-0.5 -right-0.5 h-2 w-2 rounded-full bg-accent animate-pulse"></div>
          </div>
          <div class="flex flex-col">
            <span class="font-display font-bold text-lg tracking-tight text-foreground leading-none">
              CogniLab
            </span>
            <span class="text-[0.6rem] uppercase tracking-[0.2em] text-muted-foreground/70 font-medium leading-none mt-0.5">
              SaaS Studio
            </span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden lg:block" role="menubar">
          <ul class="ml-12 flex items-center gap-1" role="none">
            {["Productos", "Nosotros", "Proyectos"].map((item) => (
              <li role="none">
                <a
                  href={`#${item === "Productos" ? "services" : item === "Nosotros" ? "about" : "projects"}`}
                  class="relative px-4 py-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors duration-200 rounded-lg hover:bg-white/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                  role="menuitem"
                >
                  {item}
                </a>
              </li>
            ))}
            <li role="none" class="ml-4">
              <a
                href="#contact"
                class="relative inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold rounded-xl bg-primary text-primary-foreground hover:bg-primary/90 transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background shadow-[0_0_20px_oklch(0.78_0.15_195/0.25)] hover:shadow-[0_0_30px_oklch(0.78_0.15_195/0.4)]"
                role="menuitem"
              >
                Contacto
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </li>
          </ul>
        </div>

        <!-- Mobile menu button -->
        <button
          type="button"
          class="mobile-menu-button lg:hidden relative flex h-10 w-10 items-center justify-center rounded-xl text-muted-foreground hover:text-foreground hover:bg-white/5 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Abrir menú de navegación"
        >
          <span class="sr-only">Abrir menú principal</span>
          <div class="flex flex-col gap-1.5 w-5">
            <span class="hamburger-line-1 block h-0.5 w-full bg-current rounded-full transition-all duration-300 origin-center"></span>
            <span class="hamburger-line-2 block h-0.5 w-3/4 bg-current rounded-full transition-all duration-300"></span>
            <span class="hamburger-line-3 block h-0.5 w-1/2 bg-current rounded-full transition-all duration-300 origin-center"></span>
          </div>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div
      class="mobile-menu hidden lg:hidden"
      id="mobile-menu"
      role="menu"
      aria-orientation="vertical"
      aria-labelledby="mobile-menu-button"
    >
      <div class="mx-4 mb-4 p-3 rounded-2xl bg-card/80 backdrop-blur-xl border border-border/50 shadow-2xl">
        <a href="#services" class="mobile-link flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-medium text-muted-foreground hover:text-foreground hover:bg-white/5 transition-all duration-200 min-h-[44px]" role="menuitem">
          <svg class="w-5 h-5 text-primary/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          Productos
        </a>
        <a href="#about" class="mobile-link flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-medium text-muted-foreground hover:text-foreground hover:bg-white/5 transition-all duration-200 min-h-[44px]" role="menuitem">
          <svg class="w-5 h-5 text-primary/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Nosotros
        </a>
        <a href="#projects" class="mobile-link flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-medium text-muted-foreground hover:text-foreground hover:bg-white/5 transition-all duration-200 min-h-[44px]" role="menuitem">
          <svg class="w-5 h-5 text-primary/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Proyectos
        </a>
        <div class="my-2 border-t border-border/30"></div>
        <a href="#contact" class="mobile-link flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-base font-semibold bg-primary text-primary-foreground hover:bg-primary/90 transition-all duration-200 min-h-[44px]" role="menuitem">
          Contacto
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navbar = document.querySelector(".navbar-glass") as HTMLElement;
    const mobileMenuButton = document.querySelector(".mobile-menu-button") as HTMLButtonElement;
    const mobileMenu = document.querySelector(".mobile-menu") as HTMLElement;

    // Scroll-aware navbar
    let lastScroll = 0;
    window.addEventListener("scroll", () => {
      const scrollY = window.scrollY;
      if (scrollY > 50) {
        navbar?.classList.add("navbar-scrolled");
      } else {
        navbar?.classList.remove("navbar-scrolled");
      }
      lastScroll = scrollY;
    }, { passive: true });

    // Mobile menu toggle
    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener("click", () => {
        const isExpanded = mobileMenuButton.getAttribute("aria-expanded") === "true";
        mobileMenu.classList.toggle("hidden");
        mobileMenuButton.setAttribute("aria-expanded", (!isExpanded).toString());

        // Animate hamburger to X
        const lines = mobileMenuButton.querySelectorAll("span[class*='hamburger-line']");
        if (!isExpanded) {
          lines[0]?.classList.add("rotate-45", "translate-y-[4px]");
          lines[0]?.classList.remove("w-full");
          lines[1]?.classList.add("opacity-0", "translate-x-2");
          lines[2]?.classList.add("-rotate-45", "-translate-y-[4px]");
          lines[2]?.classList.add("w-full");
          lines[2]?.classList.remove("w-1/2");
        } else {
          lines[0]?.classList.remove("rotate-45", "translate-y-[4px]");
          lines[0]?.classList.add("w-full");
          lines[1]?.classList.remove("opacity-0", "translate-x-2");
          lines[2]?.classList.remove("-rotate-45", "-translate-y-[4px]");
          lines[2]?.classList.add("w-full");
          lines[2]?.classList.remove("w-1/2");
        }
      });
    }

    // Close mobile menu on link click
    document.querySelectorAll(".mobile-link").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu?.classList.add("hidden");
        mobileMenuButton?.setAttribute("aria-expanded", "false");
        const lines = mobileMenuButton?.querySelectorAll("span[class*='hamburger-line']");
        lines?.[0]?.classList.remove("rotate-45", "translate-y-[4px]");
        lines?.[0]?.classList.add("w-full");
        lines?.[1]?.classList.remove("opacity-0", "translate-x-2");
        lines?.[2]?.classList.remove("-rotate-45", "-translate-y-[4px]");
        lines?.[2]?.classList.add("w-full");
        lines?.[2]?.classList.remove("w-1/2");
      });
    });

    // Close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && mobileMenu && !mobileMenu.classList.contains("hidden")) {
        mobileMenu.classList.add("hidden");
        mobileMenuButton?.setAttribute("aria-expanded", "false");
        mobileMenuButton?.focus();
      }
    });
  });
</script>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0;
  }

  .navbar-glass {
    background: oklch(0.09 0.015 260 / 0.6);
    backdrop-filter: blur(12px) saturate(150%);
    -webkit-backdrop-filter: blur(12px) saturate(150%);
    border-bottom: 1px solid oklch(1 0 0 / 0.05);
  }

  .navbar-scrolled {
    background: oklch(0.09 0.015 260 / 0.85);
    border-bottom-color: oklch(1 0 0 / 0.08);
    box-shadow: 0 4px 30px oklch(0 0 0 / 0.3);
  }

  .mobile-menu {
    animation: mobileMenuIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes mobileMenuIn {
    from { opacity: 0; transform: translateY(-8px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu { animation: none; }
  }
</style>
